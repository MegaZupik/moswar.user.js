// ==UserScript==
// @name         Moswar Mini Group Inventory
// @namespace    https://www.moswar.ru/
// @version      4.0
// @description  Mini group inventory
// @match        https://www.moswar.ru/*
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function(){

'use strict';


const BTN_ID = "mw-mini-inventory-button";
const INV_ID = "mw-mini-inventory";
const POS_KEY = "mw_mini_inventory_pos";



if(document.querySelector("#"+BTN_ID))
    return;



function savePos(el){

    localStorage.setItem(
        POS_KEY,
        JSON.stringify({
            left:el.style.left,
            top:el.style.top
        })
    );

}





function createButton(){


    let b=document.createElement("div");

    b.id=BTN_ID;



    let pos =
    JSON.parse(
        localStorage.getItem(POS_KEY)||"null"
    );



    Object.assign(b.style,{

        position:"fixed",

        left:pos ? pos.left : "20px",

        top:pos ? pos.top : "80px",

        width:"65px",

        height:"65px",

        background:"#333",

        border:"2px solid #aaa",

        borderRadius:"12px",

        zIndex:"999999",

        display:"flex",

        alignItems:"center",

        justifyContent:"center",

        touchAction:"none",

        userSelect:"none",

        cursor:"pointer"

    });




    let img=document.createElement("img");

    img.src="/@/images/obj/injectors/22_box.png";

    img.width=55;

    img.height=55;


    b.appendChild(img);


    document.body.appendChild(b);






    let drag=false;

    let moved=false;

    let dx=0;

    let dy=0;




    function start(x,y){

        drag=true;

        moved=false;

        dx=x-b.offsetLeft;

        dy=y-b.offsetTop;

    }




    function move(x,y){

        if(!drag)
            return;



        if(
            Math.abs(x-b.offsetLeft)>5 ||
            Math.abs(y-b.offsetTop)>5
        )
            moved=true;



        b.style.left=(x-dx)+"px";

        b.style.top=(y-dy)+"px";

    }





    function end(){

        if(!drag)
            return;


        drag=false;


        savePos(b);

    }





    b.addEventListener(
        "mousedown",
        e=>start(e.clientX,e.clientY)
    );


    document.addEventListener(
        "mousemove",
        e=>move(e.clientX,e.clientY)
    );


    document.addEventListener(
        "mouseup",
        end
    );






    b.addEventListener(
        "touchstart",
        e=>{

            let t=e.touches[0];

            start(t.clientX,t.clientY);

        },
        {passive:false}
    );



    b.addEventListener(
        "touchmove",
        e=>{

            let t=e.touches[0];

            move(t.clientX,t.clientY);

            e.preventDefault();

        },
        {passive:false}
    );



    b.addEventListener(
        "touchend",
        end
    );





    b.onclick=()=>{


        if(moved)
            return;



        let old=document.querySelector("#"+INV_ID);


        if(old){

            old.remove();

            return;

        }



        loadInventory(b);


    };



}









function loadInventory(button){


    console.log("Запрос player");



    fetch(
        "/player/?_="+Date.now(),
        {
            credentials:"include"
        }
    )
    .then(r=>r.text())
    .then(html=>{


        let doc =
        new DOMParser()
        .parseFromString(
            html,
            "text/html"
        );



        let inv =
        doc.querySelector(
            "#slots-groupfight-place"
        );



        if(!inv){

            console.log("Карман не найден");

            return;

        }



        console.log("Карман найден");



        showInventory(
            inv.cloneNode(true),
            button
        );



    });



}









function showInventory(inv,button){



    inv.id=INV_ID;



    // убрать заголовок

    inv.querySelector(
        ".slots-groupfight-header"
    )?.remove();



    // убрать крестик

    inv.querySelector(
        ".close-cross"
    )?.remove();





    let list =
    inv.querySelector(
        ".object-thumbs"
    );



    if(list){


        Object.assign(list.style,{

            display:"flex",

            flexDirection:"column",

            gap:"5px",

            width:"max-content",

            height:"auto",

            maxHeight:"none",

            maxWidth:"none",

            overflow:"visible"

        });


    }




    inv.querySelectorAll(
        ".object-thumb"
    )
    .forEach(x=>{


        Object.assign(x.style,{

            width:"max-content",

            height:"max-content"

        });


    });






    Object.assign(inv.style,{

        display:"block",

        position:"absolute",

        left:"0",

        top:"70px",

        width:"max-content",

        height:"max-content",

        transform:"scale(0.4)",

        transformOrigin:"top left",

        zIndex:"999999"

    });




    button.appendChild(inv);



    console.log(
        "Инвентарь показан"
    );


}






createButton();



})();

// ==UserScript==
// @name         Moswar Mini Group Inventory Live
// @namespace    http://tampermonkey.net/
// @version      5.0
// @description  Mini live group inventory
// @match        *://www.moswar.ru/*
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function(){

'use strict';


const POS_KEY="mw-mini-inventory-button-pos";



function createUI(){


    if(document.querySelector("#mw-mini-wrapper"))
        return;



    let wrap=document.createElement("div");

    wrap.id="mw-mini-wrapper";


    Object.assign(wrap.style,{
        position:"fixed",
        left:"300px",
        top:"200px",
        zIndex:"9999999"
    });



    let saved =
    JSON.parse(localStorage.getItem(POS_KEY));


    if(saved){

        wrap.style.left=saved.left;
        wrap.style.top=saved.top;

    }






    let btn=document.createElement("div");



    Object.assign(btn.style,{

        width:"65px",

        height:"65px",

        background:"#333",

        border:"2px solid #aaa",

        borderRadius:"12px",

        display:"flex",

        alignItems:"center",

        justifyContent:"center",

        touchAction:"none",

        userSelect:"none"

    });





    let img=document.createElement("img");


    img.src="/@/images/obj/injectors/22_box.png";



    Object.assign(img.style,{

        width:"55px",

        height:"55px",

        cursor:"pointer",

        userSelect:"none",

        pointerEvents:"none",

        webkitUserDrag:"none"

    });



    btn.appendChild(img);


    wrap.appendChild(btn);

    document.body.appendChild(wrap);






    let drag={

        active:false,

        moved:false,

        x:0,

        y:0,

        left:0,

        top:0

    };





    btn.addEventListener("pointerdown",e=>{


        drag.active=true;

        drag.moved=false;



        let r=wrap.getBoundingClientRect();



        drag.x=e.clientX;

        drag.y=e.clientY;



        drag.left=r.left;

        drag.top=r.top;



        btn.setPointerCapture(e.pointerId);



    });







    btn.addEventListener("pointermove",e=>{


        if(!drag.active)
            return;



        let dx=e.clientX-drag.x;

        let dy=e.clientY-drag.y;




        if(Math.abs(dx)>3 || Math.abs(dy)>3)
            drag.moved=true;



        wrap.style.left =
        drag.left+dx+"px";



        wrap.style.top =
        drag.top+dy+"px";



    });







    btn.addEventListener("pointerup",()=>{


        drag.active=false;



        localStorage.setItem(
            POS_KEY,
            JSON.stringify({

                left:wrap.style.left,

                top:wrap.style.top

            })
        );


    });









    btn.addEventListener("click",()=>{


        if(drag.moved)
            return;



        let inv=document.querySelector(
            "#mw-mini-inventory"
        );



        if(inv){

            inv.remove();

            return;

        }



        loadInventory();



    });



}









function loadInventory(){


    console.log("Создаю player iframe");



    let old=document.querySelector(
        "#mw-player-frame"
    );



    if(old)
        old.remove();





    let frame=document.createElement("iframe");


    frame.id="mw-player-frame";



    Object.assign(frame.style,{

        position:"fixed",

        width:"1px",

        height:"1px",

        opacity:"0",

        pointerEvents:"none",

        left:"-20px",

        top:"-20px"

    });





    frame.src="/player/?_="+Date.now();



    document.body.appendChild(frame);






    frame.onload=()=>{


        console.log("iframe загружен");



        let timer=setInterval(()=>{


            try{


                let inv =
                frame.contentDocument
                .querySelector(
                    "#slots-groupfight-place"
                );



                if(inv){


                    console.log("Карман найден");

                    clearInterval(timer);



                    showInventory(
                        inv.cloneNode(true)
                    );



                    frame.remove();


                }


            }catch(e){}



        },500);



    };


}









function showInventory(inv){



    let old=document.querySelector(
        "#mw-mini-inventory"
    );


    if(old)
        old.remove();





    inv.id="mw-mini-inventory";





    inv.querySelector(
        ".slots-groupfight-header"
    )?.remove();





    inv.querySelector(
        ".close-cross"
    )?.remove();








    let list =
    inv.querySelector(
        ".object-thumbs"
    );





    if(list){


        Object.assign(list.style,{

            display:"flex",

            flexDirection:"column",

            flexWrap:"nowrap",

            width:"fit-content",

            height:"auto",

            maxHeight:"none",

            maxWidth:"none",

            overflow:"visible",

            gap:"5px"

        });


    }







    inv.querySelectorAll(
        ".object-thumb"
    )
    .forEach(el=>{


        Object.assign(el.style,{

            width:"fit-content",

            height:"fit-content"

        });



    });









    Object.assign(inv.style,{

        display:"block",

        position:"relative",

        marginTop:"5px",

        width:"fit-content",

        height:"fit-content",

        transform:"scale(0.85)",

        transformOrigin:"top left",

        zIndex:"9999999"

    });








    document.querySelector(
        "#mw-mini-wrapper"
    )
    .appendChild(inv);



    console.log(
        "Мини инвентарь показан"
    );



}








setTimeout(
    createUI,
    2000
);



})();
